{
  "version": 2,
  "builds": [
    {
      "src": "src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/main.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/notifications/daily",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/telegram/football-daily",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/chat/knowledge/backfill-embeddings",
      "schedule": "0 20 * * *"
    }
  ]
}
