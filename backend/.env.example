# Database
DATABASE_URL=postgresql://user:password@localhost:5432/family_calendar

# AI providers
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_CONTEXT_WINDOW=131072
AI_VISION_PROVIDER=groq
AI_TOOL_MODEL=openai/gpt-oss-120b
AI_MAX_TOKENS=800
AI_HISTORY_LIMIT=6
AI_RESPONSE_CACHE_TTL_MS=3600000
AI_RESPONSE_CACHE_MAX_ENTRIES=200
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash-lite
GEMINI_CONTEXT_WINDOW=1048576
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSION=768
TAVILY_API_KEY=your_tavily_api_key_here
# Optional: enables Football-Data.org fixtures/results for /football. Without it, /football falls back to Tavily search.
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Server
PORT=3001
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_jwt_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# CORS
FRONTEND_URL=http://localhost:3000

# Email
EMAIL_USER=your_email_address
EMAIL_PASS=your_email_app_password

# Web Push
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@example.com

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=https://your-backend-domain.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=your_random_telegram_webhook_secret
# Local development only. Leave false/empty on Vercel.
TELEGRAM_USE_POLLING=false

# Scheduled jobs
CRON_SECRET=your_cron_secret

# Weather provider for proactive assistant
WEATHER_PROVIDER=weatherapi
WEATHERAPI_KEY=your_weatherapi_key_here
WEATHER_LOCATION=Ha Noi
