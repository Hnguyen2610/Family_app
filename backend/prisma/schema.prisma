// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

// ============================================
// User & Family
// ============================================
model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  role                  String?
  globalRole            String    @default("USER")
  birthday              DateTime?
  familyId              String?
  family                Family?   @relation("LegacyFamily", fields: [familyId], references: [id], onDelete: SetNull)
  families              Family[]  @relation("UserFamilies")
  googleId              String?   @unique
  avatarUrl             String?
  notificationSettings  Json?     @default("{}")
  telegramChatId        String?   @unique
  telegramUsername      String?
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?

  createdEvents   Event[]
  mealPreferences MealPreference[]

  foodLikes          Json?
  foodDislikes       Json?
  healthRestrictions Json?
  dailyRoutine       Json?
  aiProfileNotes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  transactions      Transaction[]
  budgets           Budget[]
  dailyTasks        DailyTask[]
}

model Family {
  id              String       @id @default(cuid())
  name            String
  users           User[]       @relation("UserFamilies")
  legacyUsers     User[]       @relation("LegacyFamily")
  aiDocuments     AiDocument[]
  telegramGroupId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// Calendar & Events
// ============================================
model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime // Solar date
  endDate     DateTime?
  time        String? // Ex: "09:00"
  lunarDate   String? // Ex: "30/12" (day/month in lunar calendar)
  type        EventType @default(GENERAL)

  isRecurring Boolean @default(false)
  recurring   String? // CRON expression (if recurring)

  familyId  String
  createdBy String
  user      User   @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  scope EventScope @default(GLOBAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([familyId])
}

enum EventType {
  BIRTHDAY
  ANNIVERSARY
  HOLIDAY
  APPOINTMENT
  TASK
  GENERAL
}

enum EventScope {
  PRIVATE
  FAMILY
  GLOBAL
}

// ============================================
// Meals & Preferences
// ============================================
model Meal {
  id       String       @id @default(cuid())
  name     String
  category MealCategory
  tags     String[] // ["healthy", "fast", "vegan", etc.]

  preferences MealPreference[]
  history     MealHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MealCategory {
  MAIN_COURSE
  VEGETABLE
  SOUP
}

model MealPreference {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealId String
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, mealId])
}

model MealHistory {
  id       String       @id @default(cuid())
  mealId   String
  meal     Meal         @relation(fields: [mealId], references: [id], onDelete: Cascade)
  date     DateTime
  category MealCategory
  familyId String       @default("default-family")

  createdAt DateTime @default(now())

  @@index([date])
  @@index([mealId])
  @@index([familyId])
}

// ============================================
// AI Chat
// ============================================
model ChatSession {
  id       String @id @default(cuid())
  familyId String
  title    String

  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
}

model ChatMessage {
  id        String       @id @default(cuid())
  familyId  String
  sessionId String?
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "user" or "assistant"
  content   String

  createdAt DateTime @default(now())

  @@index([familyId])
  @@index([sessionId])
  @@index([createdAt])
}

model AiDocument {
  id         String  @id @default(cuid())
  familyId   String
  family     Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  title      String
  content    String
  sourceType String  @default("family_wiki")
  createdBy  String?
  metadata   Json?

  chunks AiDocumentChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
  @@index([createdAt])
}

model AiDocumentChunk {
  id              String                      @id @default(cuid())
  documentId      String
  document        AiDocument                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  familyId        String
  content         String
  chunkIndex      Int
  tokenHint       Int                         @default(0)
  embedding       Json?
  embeddingVector Unsupported("vector(768)")? @map("embedding_vector")
  metadata        Json?

  createdAt DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([familyId])
}

model AiExtractionDraft {
  id             String  @id @default(cuid())
  familyId       String
  userId         String?
  draftType      String
  status         String  @default("DRAFT")
  sourceType     String  @default("image")
  summary        String?
  rawText        String?
  structuredData Json
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AiRequestLog {
  id                 String   @id
  timestamp          DateTime @default(now())
  type               String
  source             String?
  intent             String
  prompt             String?
  normalizedPrompt   String?
  skill              String?
  model              String
  routeReason        String?
  routeConfidence    Float?
  toolsCalled        String[] @default([])
  ragSnippetCount    Int?
  ragQuery           String?
  ragMiss            Boolean?
  ragSources         Json?
  resolverTelemetry  Json?
  proposedAction     Json?
  sanitizerIncidents Json?
  needsClarification Boolean  @default(false)
  latencyMs          Int      @default(0)
  cached             Boolean  @default(false)
  redacted           Boolean  @default(false)
  userId             String?
  familyId           String?
  sessionId          String?
  error              String?
  fallbackReason     String?
  modelChoiceReason  String?
  tokenCount         Int?
  resolvedFamilyMode String? // 'single' | 'all' | 'telegram_group' | 'private'

  feedbacks AiRequestFeedback[]

  @@index([timestamp])
  @@index([familyId])
  @@index([intent])
  @@index([skill])
  @@index([model])
  @@index([cached])
}

model AiRequestFeedback {
  id           String       @id @default(cuid())
  requestLogId String
  requestLog   AiRequestLog @relation(fields: [requestLogId], references: [id], onDelete: Cascade)
  value        String
  source       String
  userId       String?
  comment      String?
  createdAt    DateTime     @default(now())

  @@index([requestLogId])
  @@index([value])
  @@index([createdAt])
}

model AiActionProposal {
  id                   String   @id @default(cuid())
  userId               String
  familyId             String?
  source               String
  action               String
  payload              Json
  status               String   @default("PENDING")
  targetType           String?
  targetId             String?
  riskLevel            String?  @default("low")
  requiresConfirmation Boolean  @default(true)
  before               Json?
  after                Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  expiresAt            DateTime

  @@index([userId])
  @@index([familyId])
  @@index([status])
  @@index([expiresAt])
}

// ============================================
// Notifications
// ============================================
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String // e.g., "EVENT_CREATED", "MEAL_ADDED"
  title    String
  message  String
  metadata Json? // { eventId: "...", path: "/calendar" }

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============================================
// Web Push Notifications
// ============================================
model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================
// Finance & Budgeting
// ============================================
model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount      Float
  type        TransactionType     @default(EXPENSE)
  category    TransactionCategory @default(OTHER)
  description String?
  date        DateTime            @default(now())

  // PayOS specific metadata
  reference String? @unique // Bank reference number
  paymentId String? @unique // PayOS payment ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([date])
}

model Budget {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  monthlyIncome Float @default(0)
  dailyBudget   Float @default(0)
  month         Int
  year          Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  FOOD // Ăn uống
  TRANSPORT // Di chuyển
  SHOPPING // Mua sắm
  UTILITIES // Tiền điện/nước/mạng
  RENT // Tiền nhà
  ENTERTAINMENT // Giải trí
  HEALTH // Sức khỏe
  EDUCATION // Giáo dục
  SALARY // Lương (Income)
  BONUS // Thưởng (Income)
  INVESTMENT // Đầu tư
  OTHER // Khác
}

// ============================================
// Daily Tasks
// ============================================
model DailyTask {
  id              String    @id @default(cuid())
  userId          String
  title           String
  priority        Int       @default(0) // 0 = cao nhất, tăng dần = thấp hơn
  intervalMinutes Int       @default(30) // số phút bất kỳ giữa các lần nhắc
  repeatWeekdays  Json?
  activeStartTime String?   @default("08:00")
  activeEndTime   String?   @default("17:00")
  nextReminderAt  DateTime?
  isActive        Boolean   @default(true)
  lastNotifiedAt  DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// AI Conversation State
// ============================================
model AiConversationState {
  id                   String   @id @default(cuid())
  userId               String   @unique
  familyId             String?
  lastShownEvents      Json? // JSON array of event metadata: [{ eventId, date, time, title, scope, familyId, rowNumber }]
  lastShownNotes       Json? // JSON array of note metadata: [{ noteId, title, familyId, category, rowNumber }]
  lastShownTasks       Json? // JSON array of task metadata: [{ taskId, title, priority, rowNumber }]
  lastSelectedFamilyId String?
  lastIntent           String?
  lastAssistantSummary String?
  pendingReference     Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  expiresAt            DateTime

  @@index([userId])
  @@index([expiresAt])
}

// ============================================
// Notification Delivery Log (Phase 4)
// ============================================
model NotificationDeliveryLog {
  id           String   @id @default(cuid())
  userId       String?
  familyId     String?
  type         String // e.g., EVENT_REMINDER, DAILY_TASK, HOROSCOPE
  channel      String // telegram | webpush | email | inapp
  status       String // SENT | FAILED | SKIPPED
  title        String
  body         String
  metadata     Json?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([createdAt])
  @@index([status])
}

// Atomic "claim" a user's once-per-day football schedule send. NotificationDeliveryLog
// alone can't prevent a double-send here: two near-simultaneous cron triggers (the Vercel
// cron endpoint plus the in-process @Cron on a warm serverless instance both firing around
// 07:00 ICT) can each pass a "was it already sent?" check before either has written a row.
// Racing on this table's unique (userId, dateKey) instead makes the DB reject the loser
// atomically, so only one caller ever proceeds to actually send the Telegram message.
model FootballDailyNotificationClaim {
  id        String   @id @default(cuid())
  userId    String
  dateKey   String
  createdAt DateTime @default(now())

  @@unique([userId, dateKey])
}

// ============================================
// Family Knowledge Version History (Phase 7)
// ============================================
model FamilyKnowledgeVersion {
  id         String   @id @default(cuid())
  documentId String
  title      String
  content    String
  category   String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([createdAt])
}

// ============================================
// AI Eval Cases (Phase 6)
// ============================================
model AiEvalCase {
  id             String   @id @default(cuid())
  input          String
  expectedIntent String?
  expectedSkill  String?
  expectedAnswer String?
  expectedTool   String?
  sourceLogId    String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

